      season[1]: year_round
      functional_description: Burrowing rodent creating extensive tunnel systems in sandy soils. Creates habitat structure for other species.
      life_stages: []
      region: florida
      ecological_role: herbivore
      is_keystone: true
      keystone_type: ecosystem_engineer
      keystone_description: Creates burrow systems used by other species; disturbed soil affects plant communities.
      taxonomic_group: group_small_mammals
