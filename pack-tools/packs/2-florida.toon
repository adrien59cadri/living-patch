metadata:
  id: florida-base
  author: LivingPatch Contributors
  version: 1.0.0
  schemaVersion: 1.0.0
  description: "Florida species — mammals, birds, reptiles, amphibians, invertebrates, plants, and fungi"
  createdDate: "2026-06-02T00:00:00.000Z"
  status: published
data:
  species[208]:
    - id: mammal_eastern-cottontail
      common_name: Eastern Cottontail
      latin_name: Sylvilagus floridanus
      form: rabbit
      habitat[3]: grassland,field,scrubland
      diet[1]: herbivore
      behavior[1]: crepuscular
      season[1]: year_round
      functional_description: Small rabbit found in open fields and brushy areas. Important prey for raptors and carnivorous mammals.
      life_stages: []
      region: florida
      ecological_role: herbivore
      taxonomic_group: group_small_mammals
